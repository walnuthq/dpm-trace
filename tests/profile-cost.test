# Stdout-only checks here: the export/diff/budget round-trip needs scratch
# files, and check-profile.py drives that in a tempdir so the suite does not
# depend on a writable lit output directory.

# RUN: env PYTHONPATH=%root/src %python -m dpm_trace.cli profile tx --trace %root/tests/fixtures/profile/transfer-before.trace-artifact.json --price-per-byte 0.0000001 | FileCheck %s

# CHECK: DPM cost profile
# CHECK: subject:      update-000000000001
# CHECK: nodes:        3
# CHECK: modeled:
# CHECK: est. cost:
# CHECK-SAME: (estimate at
# CHECK: By template
# CHECK: Asset:Asset
# CHECK: Largest payload fields
# CHECK: Tree
# CHECK: exercise
# CHECK-SAME: Transfer
# CHECK: create
# CHECK: Byte counts are a deterministic model

# A committed update fetched as JSON carries no wire size, so the profile must
# not claim a measured one.
# RUN: env PYTHONPATH=%root/src %python -m dpm_trace.cli profile tx --trace %root/tests/fixtures/profile/transfer-before.trace-artifact.json --json | FileCheck --check-prefix=JSON %s

# JSON: "schema": "dpm-profile/v1"
# JSON-NOT: measuredWireBytes

# With daml-debug-info/v1 the size table becomes a place to go: each hot spot
# names the file and line it is written at. Templates the metadata does not
# cover say so rather than being dropped or guessed at.
# RUN: env PYTHONPATH=%root/src %python -m dpm_trace.cli profile tx --trace %root/tests/fixtures/profile/transfer-after.trace-artifact.json --debug-info %root/tests/fixtures/debug-info-v1/asset.debug-info.json --source-root %root/tests/fixtures/debug-info-v1 | FileCheck --check-prefix=HOT %s

# HOT: Hot spots
# HOT: Asset:Asset
# HOT-SAME: Asset.daml:9
# HOT: Asset:Asset :: Transfer
# HOT-SAME: Asset.daml:18
# HOT: Asset:TransferLog :: Record
# HOT-SAME: (source not resolved)

# Without metadata it says why, instead of silently omitting the section.
# RUN: env PYTHONPATH=%root/src %python -m dpm_trace.cli profile tx --trace %root/tests/fixtures/profile/transfer-after.trace-artifact.json | FileCheck --check-prefix=NOSRC %s

# NOSRC: No source locations
# NOSRC-SAME: --debug-info

